# Copy to .env (`make up` does it for you). .env is git-ignored.
# Every value here is a local-only default; nothing in this file is a real secret.

COMPOSE_PROJECT_NAME=ecommerce

# Host interface for every published port. Loopback only by default: these services run with
# local-only credentials. Set to 0.0.0.0 (or a LAN IP) only to reach the stack from another
# machine on a network you trust.
HOST_BIND=127.0.0.1

# Host ports (change any of them if they clash with something on your machine)
HTTP_PORT=8080
PG_PORT=55432
MEILI_PORT=57700
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
STRIPE_MOCK_PORT=12111

# Local credentials
POSTGRES_PASSWORD=postgres-local
APP_OWNER_PASSWORD=app-owner-local
APP_RUNTIME_PASSWORD=app-runtime-local
AUTH_DB_PASSWORD=auth-service-local
# Better Auth: cookie signing + JWT private key encryption (>= 32 chars)
BETTER_AUTH_SECRET=local-better-auth-secret-0123456789abcdef
# Service tokens (>= 32 chars): API CLI -> auth service, edge/services -> /internal/v1
AUTH_INTERNAL_TOKEN=local-auth-internal-token-0123456789abcdef
INTERNAL_API_TOKEN=local-internal-api-token-0123456789abcdef
MEILI_MASTER_KEY=meili-local-master-key-0123456789
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=minio-local-password
# S3 user the app runs as (created by minio-init with the readwrite policy)
S3_ACCESS_KEY_ID=app-local
S3_SECRET_ACCESS_KEY=app-local-secret-key

# App settings (containers)
APP_ENV=dev
RUST_LOG=info
