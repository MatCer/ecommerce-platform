#!/usr/bin/env bash
# Runs no tests: WIP pushes stay free. Tests run once, before merge (docs/runbook.md).
#
# Enable once per clone (`pnpm install` does it via the root `prepare` script):
#   git config core.hooksPath .githooks
set -euo pipefail

while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ "$local_ref" = "(delete)" ]; then
    echo "pre-push: refusing to delete main." >&2
  else
    cat >&2 <<'MSG'
pre-push: refusing to push directly to main.

main is PR-only. Push a branch, open a PR, run the local tests, then merge:

  git switch -c feat/<slug> && git push -u origin feat/<slug>
  gh pr create --fill
  pnpm verify <PR#>     # prints the gh pr merge command on success

A direct push to main also fails CI's gate job.
MSG
  fi
  exit 1
done
