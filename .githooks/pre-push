#!/usr/bin/env bash
# Enable once per clone (`pnpm install` does it via the root `prepare` script):
#   git config core.hooksPath .githooks
set -euo pipefail

while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ "$local_ref" = "(delete)" ]; then
    echo "pre-push: refusing to delete main." >&2
  else
    cat >&2 <<'MSG'
pre-push: refusing to push directly to main.

main is PR-only. Push a branch, open a PR, and merge it once CI and review are clean:

  git switch -c feat/<slug> && git push -u origin feat/<slug>
  gh pr create --fill
  gh pr merge <PR#> --squash --delete-branch --match-head-commit <reviewed sha>

A direct push to main also fails CI's gate job.
MSG
  fi
  exit 1
done
