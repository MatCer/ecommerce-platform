  "query": "SELECT m.asset_id, m.alt_i18n, a.variants FROM product_media m\n             JOIN assets a ON a.id = m.asset_id\n             WHERE m.product_id = $1 AND a.status = 'ready' AND ($2 OR a.created_at >= $3)\n             ORDER BY m.position",
