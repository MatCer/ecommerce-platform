{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (pm.product_id) pm.product_id, a.variants\n         FROM product_media pm JOIN assets a ON a.id = pm.asset_id AND a.status = 'ready'\n         WHERE pm.product_id = ANY($1) AND (pm.variant_id IS NULL OR pm.variant_id = ANY($2))\n         ORDER BY pm.product_id, (pm.variant_id IS NULL), pm.position",
