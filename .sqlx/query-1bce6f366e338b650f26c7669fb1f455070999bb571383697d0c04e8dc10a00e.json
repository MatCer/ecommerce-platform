  "query": "SELECT ppv.product_id, pa.key, pa.kind, pa.unit, pa.name_i18n, ppv.value\n         FROM product_parameter_values ppv JOIN parameters pa ON pa.id = ppv.parameter_id\n         WHERE pa.filterable AND ppv.product_id = ANY($1)\n         ORDER BY pa.key",
