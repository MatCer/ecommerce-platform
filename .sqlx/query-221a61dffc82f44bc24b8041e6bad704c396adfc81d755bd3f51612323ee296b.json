  "query": "SELECT o.code, o.name_i18n, v.value->>'code' AS \"value?\", v.value->'name_i18n' AS \"value_names?\"\n               FROM product_options o\n               CROSS JOIN LATERAL jsonb_array_elements(o.\"values\") AS v(value)\n               WHERE o.code = ANY($1)",
