  "query": "SELECT c.id, t.name AS \"name!\", t.slug AS \"slug!\" FROM categories c\n           CROSS JOIN LATERAL (\n               SELECT name, slug FROM category_translations ct WHERE ct.category_id = c.id\n               ORDER BY (ct.locale = $2) DESC, (ct.locale = $3) DESC, ct.locale LIMIT 1\n           ) t WHERE c.id = ANY($1)",
