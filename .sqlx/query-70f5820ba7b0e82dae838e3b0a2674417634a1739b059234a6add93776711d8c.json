  "query": "SELECT id, status, filename, mime, bytes, width, height, sha256, variants, error,\n                created_at, updated_at\n         FROM assets\n         WHERE ($1::uuid IS NULL OR id < $1) AND ($2::text IS NULL OR status = $2)\n         ORDER BY id DESC LIMIT $3",
