  "db_name": "PostgreSQL",
  "query": "SELECT metric,\n                  coalesce(round(sum(value) FILTER (WHERE date >= $2)), 0)::bigint AS \"recent!\",\n                  coalesce(round(sum(value) FILTER (WHERE date < $2)), 0)::bigint AS \"baseline!\"\n           FROM daily_metrics\n           WHERE dims = '{}' AND metric = ANY ($4) AND date BETWEEN $1 AND $3\n           GROUP BY metric",
