  "query": "SELECT v.product_id, v.id, v.sku, vp.amount_minor, vp.compare_at_minor\n             FROM variants v\n             JOIN variant_prices vp ON vp.variant_id = v.id AND vp.price_list_id = $1\n             WHERE v.product_id = ANY($2) ORDER BY v.product_id, v.position",
