  "query": "SELECT d.status, d.subject, d.customer_id, d.market_id, p.enabled, p.paused, p.market_ids\n         FROM ad_deliveries d\n         JOIN ad_platforms p ON p.tenant_id = d.tenant_id AND p.platform = d.platform\n         WHERE d.id = $1\n         FOR SHARE OF p",
