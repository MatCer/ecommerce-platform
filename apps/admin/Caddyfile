# Serves the admin SPA build. The public proxy (docker/caddy/Caddyfile) routes admin.localhost
# here and `/api/auth/*` on the same host to the auth service.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode gzip

	# CSP for the admin origin (spec §14). No inline scripts; the API and the public media
	# bucket are the only other origins. Inline style attributes come from positioning code in
	# Kobalte overlays. API_ORIGIN / MEDIA_ORIGIN are set per deployment; PREVIEW_FRAME_SRC is
	# where theme previews live (WP23; the iframe itself is sandboxed, A21).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$MEDIA_ORIGIN}; font-src 'self'; connect-src 'self' {$API_ORIGIN} {$MEDIA_ORIGIN}; frame-src {$PREVIEW_FRAME_SRC:'none'}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
	}

	# Hashed assets are immutable; the HTML shell is always revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"

	# Client-side routes fall back to the SPA shell.
	try_files {path} /index.html
	file_server
}
