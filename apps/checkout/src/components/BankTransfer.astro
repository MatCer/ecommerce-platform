---
import { t } from "@platform/storefront-sdk/format";
import type { BankTransfer } from "@platform/storefront-sdk/types";

/**
 * Bank-transfer instructions (A25): account, variable symbol, amount, message, and the QR code
 * (SPAYD for CZK, PAY by square for EUR). `qr_svg` is generated by the API from the stored
 * payload (paths only, no script), so it is inlined.
 */
interface Props {
  bank: BankTransfer;
  due: string | null;
  m: Record<string, string>;
}
const { bank: b, due, m } = Astro.props;
const rows: [string, string, boolean][] = [
  ["order.bank_account", b.bic ? `${b.iban} (${b.bic})` : b.iban, true],
  ["order.bank_account_name", b.account_name, false],
  ["order.bank_vs", b.variable_symbol, true],
  ["order.bank_amount", b.amount.formatted, true],
  ["order.bank_message", b.message, false],
];
if (due) rows.push(["order.bank_due", due, false]);
---

<section aria-labelledby="bank-transfer" class="grid gap-3 rounded-lg border border-border bg-card p-4" data-testid="bank-transfer">
  <h2 id="bank-transfer" class="font-display text-lg font-bold">{t(m, "order.bank_heading")}</h2>
  <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-start">
    <dl class="grid gap-1 text-sm">
      {
        rows.map(([key, value, strong]) => (
          <div class="grid grid-cols-[10rem_1fr] gap-2">
            <dt class="text-muted-foreground">{t(m, key)}</dt>
            <dd class:list={["break-all tabular-nums", strong && "font-semibold"]} data-testid={key}>{value}</dd>
          </div>
        ))
      }
    </dl>
    {
      b.qr_svg && (
        <figure class="grid justify-items-center gap-1">
          <div class="w-48 rounded-md bg-white p-1 [&>svg]:h-auto [&>svg]:w-full" data-testid="bank-qr" data-qr-kind={b.qr_kind} set:html={b.qr_svg} />
          <figcaption class="max-w-48 text-center text-xs text-muted-foreground">{t(m, "order.bank_qr_hint")}</figcaption>
        </figure>
      )
    }
  </div>
</section>
