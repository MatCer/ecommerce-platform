---
import "../styles/global.css";

interface Props {
  title: string;
  shopName: string;
  shopUrl: string;
  lang?: string;
  /** Localized "My account" (from the shop's messages). */
  accountLabel?: string;
  /** The two-column checkout needs more room than the account pages. */
  wide?: boolean;
}
const {
  title,
  shopName,
  shopUrl,
  lang = "cs",
  accountLabel = "Můj účet",
  wide = false,
} = Astro.props;
const width = wide ? "max-w-5xl" : "max-w-3xl";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} – {shopName}</title>
    <!-- Tenant design tokens (theme.tokens.json → CSS), served by the edge. -->
    <link rel="stylesheet" href="/_p/tokens.css" />
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-border bg-card">
      <div class:list={["mx-auto flex h-14 items-center justify-between px-4", width]}>
        <a href={shopUrl} class="font-display font-extrabold">{shopName}</a>
        <nav aria-label={accountLabel} class="flex gap-4 text-sm">
          <a href="/account" class="underline-offset-4 hover:underline">{accountLabel}</a>
        </nav>
      </div>
    </header>
    <main class:list={["mx-auto px-4 py-6", width]}>
      <slot />
    </main>
    <footer class:list={["mx-auto px-4 py-6 text-sm text-muted-foreground", width]}>
      <a href="/withdraw" class="underline">Odstoupení od smlouvy</a>
    </footer>
  </body>
</html>
