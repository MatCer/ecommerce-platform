---
import "../styles/global.css";

interface Props {
  title: string;
  shopName: string;
  shopUrl: string;
  lang?: string;
}
const { title, shopName, shopUrl, lang = "cs" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} – {shopName}</title>
    <!-- Tenant design tokens (theme.tokens.json → CSS), served by the edge. -->
    <link rel="stylesheet" href="/_p/tokens.css" />
  </head>
  <body class="min-h-dvh">
    <header class="border-b border-border bg-card">
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4">
        <a href={shopUrl} class="font-display font-extrabold">{shopName}</a>
        <nav aria-label="Účet" class="flex gap-4 text-sm">
          <a href="/account" class="underline-offset-4 hover:underline">Můj účet</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-6 text-sm text-muted-foreground">
      <a href="/withdraw" class="underline">Odstoupení od smlouvy</a>
    </footer>
  </body>
</html>
