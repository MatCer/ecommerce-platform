---
import Checkout from "../layouts/Checkout.astro";

const shopUrl = `${Astro.url.protocol}//${Astro.url.host.replace(/^checkout\./, "")}/`;
---

<Checkout title="Můj účet" shopName="Obchod" shopUrl={shopUrl}>
  <h1 class="font-display text-2xl font-bold">Můj účet</h1>
  <p class="mt-2 text-muted-foreground">Přihlášení, objednávky a adresy přibudou ve WP9.</p>
</Checkout>
