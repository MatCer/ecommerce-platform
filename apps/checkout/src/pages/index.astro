---
import ContactStep from "../islands/ContactStep";
import Checkout from "../layouts/Checkout.astro";
import { checkoutApi } from "../lib/api";

const api = checkoutApi(Astro.request);
const [shop, cart] = await Promise.all([api.shop(), api.cart()]);
const shopUrl = `${Astro.url.protocol}//${Astro.url.host.replace(/^checkout\./, "")}/`;
---

<Checkout title="Pokladna" shopName={shop?.name ?? "Obchod"} shopUrl={shopUrl}>
  <h1 class="mb-4 font-display text-2xl font-bold">Pokladna</h1>
  {
    !cart || cart.lines.length === 0 ? (
      <p>
        Košík je prázdný. <a href={shopUrl} class="text-identity-ink underline">Zpět do obchodu</a>
      </p>
    ) : (
      <div class="grid gap-6 md:grid-cols-[1fr_18rem]">
        <section aria-labelledby="contact" class="rounded-lg border border-border bg-card p-4">
          <h2 id="contact" class="mb-3 font-display text-lg font-bold">1. Kontakt</h2>
          <ContactStep client:load />
          <p class="mt-4 text-sm text-muted-foreground">Doprava, platba a souhrn přibudou ve WP10.</p>
        </section>
        <aside aria-labelledby="summary" class="rounded-lg border border-border bg-card p-4">
          <h2 id="summary" class="mb-3 font-display text-lg font-bold">Souhrn</h2>
          <ul class="grid gap-2 text-sm">
            {cart.lines.map((l) => (
              <li class="flex justify-between gap-2">
                <span>
                  {l.quantity}× {l.product_name} <span class="text-muted-foreground">({l.variant_label})</span>
                </span>
                <span class="tabular-nums">{l.total.formatted}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 flex justify-between border-t border-border pt-3 font-bold">
            <span>Mezisoučet</span>
            <span class="tabular-nums">{cart.subtotal?.formatted}</span>
          </p>
        </aside>
      </div>
    )
  }
</Checkout>
