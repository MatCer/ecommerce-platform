---
import { t } from "@platform/storefront-sdk/format";
import CheckoutForm from "../islands/CheckoutForm";
import ResumePlacement from "../islands/ResumePlacement";
import Checkout from "../layouts/Checkout.astro";
import { checkoutApi, messages, shopUrl } from "../lib/api";

// One-page checkout (spec §9.4, WP10) of the cart handed off from the shop (A1).
const api = checkoutApi(Astro.request);
const [shop, view, me] = await Promise.all([api.shop(), api.checkout(), api.me()]);
const saved = me ? await api.addresses() : [];
const m = shop?.messages ?? {};
const back = shopUrl(Astro.url);
---

<Checkout
  title={t(m, "checkout.title")}
  shopName={shop?.name ?? ""}
  shopUrl={back}
  lang={shop?.locale ?? "cs"}
  accountLabel={t(m, "account.nav")}
  wide
>
  <h1 class="mb-4 font-display text-2xl font-bold">{t(m, "checkout.title")}</h1>
  {
    !view || view.cart.lines.length === 0 ? (
      <>
      <ResumePlacement client:load m={messages(m, "checkout.resuming")} />
      <p>
        {t(m, "checkout.empty")} <a href={back} class="text-identity-ink underline">{t(m, "checkout.back_to_shop")}</a>
      </p>
      </>
    ) : (
      <CheckoutForm
        client:load
        m={messages(
          m,
          "checkout.",
          "cart.",
          "address.",
          "account.email",
          "account.invalid_email",
          "legal.terms",
          "consent.email_marketing_hint",
        )}
        locale={shop?.locale ?? "cs"}
        initial={view}
        customerEmail={me?.email}
        saved={saved}
        shopUrl={back}
      />
    )
  }
</Checkout>
