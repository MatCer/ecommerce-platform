---
import { t } from "@platform/storefront-sdk/format";
import Checkout from "../layouts/Checkout.astro";
import { checkoutApi, shopUrl } from "../lib/api";
import { Button } from "../ui.tsx";

// Abandoned-cart reminder link (WP19). A GET never consumes the capability, so mail scanners
// can open this page safely; the button's POST restores the cart once.
const shop = await checkoutApi(Astro.request).shop();
const token = Astro.url.searchParams.get("token") ?? "";
const valid = /^[0-9a-f]{64}$/.test(token) && !Astro.url.searchParams.has("invalid");
const m = shop?.messages ?? {};
---

<Checkout
  title={t(m, "flows.restore_title")}
  shopName={shop?.name ?? ""}
  shopUrl={shopUrl(Astro.url)}
  lang={shop?.locale ?? "cs"}
  accountLabel={t(m, "account.nav")}
>
  <div class="grid max-w-xl gap-4">
    <h1 class="font-display text-2xl font-bold">{t(m, "flows.restore_title")}</h1>
    {
      valid ? (
        <form method="post" action="/_p/flows/restore-cart" class="grid justify-items-start gap-4">
          <p>{t(m, "flows.restore_intro")}</p>
          <input type="hidden" name="token" value={token} />
          <Button type="submit" variant="primary">
            {t(m, "flows.restore_button")}
          </Button>
        </form>
      ) : (
        <p role="alert">{t(m, "flows.restore_invalid")}</p>
      )
    }
    <a href={shopUrl(Astro.url)} class="text-sm text-identity-ink underline">{t(m, "nl.back")}</a>
  </div>
</Checkout>
