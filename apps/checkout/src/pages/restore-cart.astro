---
import Checkout from "../layouts/Checkout.astro";
import { checkoutApi, shopUrl } from "../lib/api";

// A GET never consumes the capability: mail scanners can open this page safely.
const shop = await checkoutApi(Astro.request).shop();
const token = Astro.url.searchParams.get("token") ?? "";
const valid = /^[0-9a-f]{64}$/.test(token) && !Astro.url.searchParams.has("invalid");
const language = (shop?.locale ?? "en").slice(0, 2);
const copy = {
  cs: ["Obnovit košík", "Pokračovat k pokladně", "Odkaz je neplatný nebo již použitý."],
  sk: ["Obnoviť košík", "Pokračovať k pokladni", "Odkaz je neplatný alebo už použitý."],
  en: [
    "Restore your cart",
    "Continue to checkout",
    "This link is invalid or has already been used.",
  ],
} as const;
const words = language === "cs" ? copy.cs : language === "sk" ? copy.sk : copy.en;
---
<Checkout title={words[0]} shopName={shop?.name ?? ""} shopUrl={shopUrl(Astro.url)} lang={shop?.locale ?? "en"}>
  <div class="grid max-w-xl gap-4">
    <h1 class="font-display text-2xl font-bold">{words[0]}</h1>
    {valid ? <form method="post" action="/_p/flows/restore-cart">
      <input type="hidden" name="token" value={token} />
      <button type="submit" class="rounded bg-identity px-5 py-3 text-identity-ink">{words[1]}</button>
    </form> : <p role="alert">{words[2]}</p>}
  </div>
</Checkout>
