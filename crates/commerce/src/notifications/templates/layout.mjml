<mjml lang="{{ locale }}">
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.55" color="{{ brand.colors.ink }}" padding="6px 0" />
      <mj-button background-color="{{ brand.colors.accent }}" color="{{ brand.colors.accent_ink }}" font-size="15px" font-weight="700" border-radius="6px" inner-padding="12px 22px" padding="14px 0" align="left" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{ brand.colors.background }}" width="600px">
    <mj-section padding="28px 24px 12px">
      <mj-column>
{% if brand.logo_url %}
        <mj-image src="{{ brand.logo_url }}" alt="{{ brand.shop_name }}" href="{{ brand.shop_url }}" width="160px" align="left" padding="0" />
{% else %}
        <mj-text font-size="20px" font-weight="700" padding="0"><a href="{{ brand.shop_url }}" style="color: {{ brand.colors.ink }}; text-decoration: none;">{{ brand.shop_name }}</a></mj-text>
{% endif %}
      </mj-column>
    </mj-section>
    <mj-section background-color="{{ brand.colors.card }}" padding="28px 24px" border-radius="8px">
      <mj-column>
{% block content %}{% endblock %}
      </mj-column>
    </mj-section>
    <mj-section padding="16px 24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="{{ brand.colors.muted }}" padding="0">{{ t("footer", shop=brand.shop_name) }} <a href="{{ brand.shop_url }}" style="color: {{ brand.colors.muted }};">{{ brand.shop_url }}</a></mj-text>
{% block footer_extra %}{% endblock %}
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
