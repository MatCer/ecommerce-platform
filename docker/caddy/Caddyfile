# Local reverse proxy (spec §3.2). Plain HTTP on *.localhost, which browsers and curl resolve
# to loopback without /etc/hosts edits. Host port: HTTP_PORT (default 8080).
{
	# Plain-HTTP sites stay HTTP (explicit http://); only the tls-internal block below gets certs.
	auto_https disable_redirects
	skip_install_trust
	admin off
}

# Service-to-service endpoints stay on the compose network: /internal/* is never proxied.
# The Storefront API is reached only through the edge (spec A4), never from browsers directly.
http://api.localhost {
	respond /internal/* "not found" 404
	respond /storefront/* "not found" 404
	reverse_proxy api:8000
}

# Better Auth rate-limits per client IP (WP12): Caddy overwrites X-Real-IP with the peer
# address, the only IP header the auth service trusts (AUTH_CLIENT_IP_HEADER).
http://auth.localhost {
	respond /internal/* "not found" 404
	reverse_proxy auth:3000 {
		header_up X-Real-IP {remote_host}
	}
}

http://mail.localhost {
	reverse_proxy mailpit:8025
}

http://s3.localhost {
	reverse_proxy minio:9000
}

# Third-party stand-ins the browser loads (WP10: the Packeta pickup-point widget) and the
# local webhook receiver that e2e tests read back (WP14). The other mock endpoints (DNS stub,
# ...) stay on the compose network.
http://mocks.localhost {
	handle /packeta/* {
		reverse_proxy mocks:4010
	}
	handle /webhooks/* {
		reverse_proxy mocks:4010
	}
	respond "not found" 404
}

# Admin SPA (WP5). Better Auth is served on the admin origin too: `*.localhost` hosts are
# separate sites, so a SameSite=Lax session cookie on auth.localhost would never reach fetches
# from the SPA. On the admin origin the cookie is first-party (auth.localhost keeps JWKS).
http://admin.localhost {
	handle /api/auth/* {
		reverse_proxy auth:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		reverse_proxy admin:80
	}
}

# Everything else is a storefront host for the edge (WP2/WP6): <shop>.localhost,
# checkout.<shop>.localhost (spec A1), preview-<rev>--<shop>.localhost. The edge resolves the
# tenant from Host and strips client-supplied X-Forwarded-*/X-Tenant headers itself (A2).
# gzip matches how the §9.6 JS budget is defined (prod: Cloudflare compresses).
:80 {
	encode gzip
	reverse_proxy edge:8787
}

# The same shops over TLS + HTTP/2 (local CA, `tls internal`), used by the performance gate:
# production is served over h2/h3, and measuring over plain HTTP/1.1 penalises island pages
# (6-connection limit, a TCP handshake per extra connection) by ~300-400 ms of simulated LCP.
https://demo.localhost, https://demo-sk.localhost, https://checkout.demo.localhost, https://checkout.demo-sk.localhost {
	tls internal
	encode gzip
	reverse_proxy edge:8787
}
