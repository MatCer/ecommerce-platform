# Local reverse proxy (spec §3.2). Plain HTTP on *.localhost, which browsers and curl resolve
# to loopback without /etc/hosts edits. Host port: HTTP_PORT (default 8080).
{
	auto_https off
	admin off
}

# Service-to-service endpoints stay on the compose network: /internal/* is never proxied.
http://api.localhost {
	respond /internal/* "not found" 404
	reverse_proxy api:8000
}

http://auth.localhost {
	respond /internal/* "not found" 404
	reverse_proxy auth:3000
}

http://mail.localhost {
	reverse_proxy mailpit:8025
}

http://s3.localhost {
	reverse_proxy minio:9000
}

# Placeholder until the admin SPA work package lands.
http://admin.localhost {
	respond "{host} is not available yet" 502
}

# Everything else is a storefront host for the edge (WP2/WP6): <shop>.localhost,
# checkout.<shop>.localhost (spec A1), preview-<rev>--<shop>.localhost.
:80 {
	respond "storefront edge is not available yet" 502
}
