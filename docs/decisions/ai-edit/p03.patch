--- themes/default/src/islands/DispatchCountdown.tsx	1970-01-01 01:00:00.000000000 +0100
+++ /tmp/wp2-scratch/theme/src/islands/DispatchCountdown.tsx	2026-09-25 01:38:53.143232421 +0200
@@ -0,0 +1,52 @@
+import { createSignal, onCleanup, onMount, Show } from "solid-js";
+
+const CUTOFF_HOUR = 14; // merchant's daily dispatch cutoff, Europe/Prague
+
+/** Prague wall-clock parts for `now`. */
+function prague(now: Date) {
+  const parts = Object.fromEntries(
+    new Intl.DateTimeFormat("en-GB", {
+      timeZone: "Europe/Prague",
+      weekday: "short",
+      hour: "2-digit",
+      minute: "2-digit",
+      hourCycle: "h23",
+    })
+      .formatToParts(now)
+      .map((p) => [p.type, p.value]),
+  );
+  return { weekday: parts.weekday ?? "", minutes: Number(parts.hour) * 60 + Number(parts.minute) };
+}
+
+/**
+ * "Order within 2 h 15 min and we ship today." Computed in the browser because the HTML is
+ * edge-cached; renders nothing on the server (no stale countdown in cached pages).
+ */
+export default function DispatchCountdown() {
+  const [text, setText] = createSignal<string | null>(null);
+  const tick = () => {
+    const { weekday, minutes } = prague(new Date());
+    const left = CUTOFF_HOUR * 60 - minutes;
+    const workday = !["Sat", "Sun"].includes(weekday);
+    if (workday && left > 0) {
+      const h = Math.floor(left / 60);
+      const m = left % 60;
+      setText(`Objednejte do ${h > 0 ? `${h} h ` : ""}${m} min a odešleme ještě dnes.`);
+    } else {
+      setText(weekday === "Fri" || weekday === "Sat" ? "Odešleme v pondělí." : "Odešleme zítra.");
+    }
+  };
+  let timer: ReturnType<typeof setInterval> | undefined;
+  onMount(() => {
+    tick();
+    timer = setInterval(tick, 30_000);
+  });
+  onCleanup(() => clearInterval(timer));
+  return (
+    <Show when={text()}>
+      <p class="text-sm font-semibold text-stock-in" aria-live="polite">
+        {text()}
+      </p>
+    </Show>
+  );
+}
