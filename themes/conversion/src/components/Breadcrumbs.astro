---
import type { Link } from "@platform/storefront-sdk/types";
import Icon from "./Icon.astro";

/** Breadcrumb trail; its BreadcrumbList JSON-LD comes with the page model's `seo.json_ld`. */
interface Props {
  items: Link[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="py-3 text-sm text-muted-foreground md:py-4">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((b, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <Icon name="chevronRight" class="size-3.5 text-subtle" />}
          {i === items.length - 1 ? (
            <span aria-current="page" class="font-medium text-foreground">{b.label}</span>
          ) : (
            <a href={b.href} class="inline-flex min-h-6 items-center underline-offset-4 hover:text-foreground hover:underline">{b.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
