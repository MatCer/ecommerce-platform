---
import type { Alternate, ShopModel } from "@platform/storefront-sdk/types";
import { i18n } from "../lib/i18n";
import Icon from "./Icon.astro";
import TrustStrip from "./TrustStrip.astro";

/**
 * Footer: newsletter, category and service links, legal links incl. the withdrawal form on the
 * checkout origin (A19) and cookie settings, payment/delivery marks (own text marks, no
 * third-party logos), country/language switch pointing at this page's hreflang alternates.
 */
interface Props {
  shop: ShopModel;
  /** hreflang alternates of the current page (switch to the same page, else the home page). */
  alternates: Alternate[];
}
const { shop, alternates } = Astro.props;
const { t } = i18n(shop);
// Outcome of the no-JS newsletter form: the edge redirects back with ?newsletter=ok|invalid.
const newsletter = Astro.url.searchParams.get("newsletter");
// Marks are the methods checkout offers in this market (own text marks, no third-party logos).
const PAYMENT_ICON = { stripe: "card", fake: "card", bank_transfer: "bank", cod: "cash" } as const;
const CARRIER_ICON = {
  packeta_pickup: "pin",
  personal_pickup: "pin",
  packeta_home: "truck",
  ppl: "truck",
} as const;
const { payment_methods: payments, carriers } = shop.trust;
const same = (hreflang: string) => alternates.find((a) => a.locale === hreflang)?.href;
const current = shop.markets.find((m) => m.current);
const country = current?.locale.split("-")[1];
// Each language in its own name ("Slovenčina", "Čeština"): a reader looks for their language.
const languageName = (code: string) => {
  const name = new Intl.DisplayNames([code], { type: "language" }).of(code) ?? code;
  return name.charAt(0).toLocaleUpperCase(code) + name.slice(1);
};
const heading = "mb-4 text-lg font-bold text-card";
const link =
  "inline-flex min-h-8 items-center text-panel-foreground/85 underline-offset-4 hover:text-card hover:underline";
---

<TrustStrip shop={shop} />
<footer class="bg-panel text-sm text-panel-foreground [--focus-ring:var(--color-card)]">
  <div class="container-shop grid gap-10 py-12 md:grid-cols-2 md:py-16 lg:grid-cols-[1fr_1fr_1fr_1.4fr]">
    <nav aria-labelledby="footer-shop">
      <h2 id="footer-shop" class={heading}>{t("footer.shop")}</h2>
      <ul class="grid gap-1">
        {shop.menus.main.map((m) => <li><a href={m.href} class={link}>{m.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="footer-service">
      <h2 id="footer-service" class={heading}>{t("footer.customer_service")}</h2>
      <ul class="grid gap-1">
        {shop.menus.footer.map((m) => <li><a href={m.href} class={link}>{m.label}</a></li>)}
        <li><a href={`${shop.checkout_url}/account`} class={link}>{t("nav.account")}</a></li>
        <li><a href={`${shop.checkout_url}/withdraw`} class={link}>{t("footer.withdrawal")}</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class={heading}>{t("footer.legal")}</h2>
      <ul class="grid gap-1">
        {shop.legal_pages.map((m) => <li><a href={m.href} class={link}>{m.label}</a></li>)}
        <li><a href={shop.consent.policy_url} class={link}>{t("legal.cookies")}</a></li>
        <li>
          <!-- The platform consent banner opens on any [data-consent-settings] element. -->
          <button type="button" data-consent-settings class={`${link} cursor-pointer`}>{t("footer.cookie_settings")}</button>
        </li>
      </ul>
    </nav>
    <section aria-labelledby="footer-newsletter">
      <p class="mb-5 font-display text-3xl font-bold tracking-tight text-card">{shop.name}</p>
      <h2 id="footer-newsletter" class={heading}>{t("newsletter.title")}</h2>
      <p class="mb-3 max-w-sm text-panel-foreground/85">{t("footer.newsletter_text")}</p>
      {
        newsletter === "ok" ? (
          <p role="status" class="font-semibold text-card">{t("newsletter.done")}</p>
        ) : (
          <form id="newsletter" method="post" action="/_p/newsletter" class="flex max-w-sm flex-col gap-2 sm:flex-row">
            <label for="nl-email" class="sr-only">{t("newsletter.email")}</label>
            <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder={t("newsletter.placeholder")} aria-invalid={newsletter === "invalid" ? "true" : undefined} aria-describedby={newsletter === "invalid" ? "nl-error" : undefined} class="h-11 min-w-0 flex-1 rounded-md border border-white/25 bg-panel-raised px-3 text-card placeholder:text-panel-foreground/70 focus-visible:outline-card" />
            <button type="submit" class="btn btn-primary">{t("newsletter.submit")}</button>
          </form>
        )
      }
      {newsletter === "invalid" && <p id="nl-error" role="alert" class="mt-2 text-card">{t("newsletter.invalid")}</p>}
    </section>
  </div>

  <div class="bg-panel-deep">
    <div class="container-shop grid gap-6 py-6 lg:grid-cols-[1fr_auto_auto] lg:items-center lg:gap-10">
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {
          payments.length > 0 && (
            <div>
              <h2 id="footer-payments" class="sr-only">{t("footer.payments")}</h2>
              <ul class="flex flex-wrap gap-2" aria-labelledby="footer-payments">
                {payments.map((p) => (
                  <li class="flex h-8 items-center gap-1.5 rounded-sm bg-card px-2.5 text-xs font-semibold text-foreground">
                    <Icon name={PAYMENT_ICON[p.kind]} class="size-4" />
                    {p.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          carriers.length > 0 && (
            <div>
              <h2 id="footer-delivery" class="sr-only">{t("footer.delivery")}</h2>
              <ul class="flex flex-wrap gap-2" aria-labelledby="footer-delivery">
                {carriers.map((c) => (
                  <li class="flex h-8 items-center gap-1.5 rounded-sm bg-card px-2.5 text-xs font-semibold text-foreground">
                    <Icon name={CARRIER_ICON[c.carrier]} class="size-4" />
                    {c.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <a href="#" class="inline-flex min-h-11 items-center gap-2 font-semibold text-card hover:underline">
        <Icon name="chevronDown" class="size-4 rotate-180" />
        {t("footer.back_to_top")}
      </a>
      {
        (shop.markets.length > 1 || shop.locales.length > 1) && (
          <nav aria-label={t("footer.region")} class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <Icon name="globe" class="size-4" />
            {shop.markets.map((m) => (
              <a href={m.current ? undefined : (same(m.locale) ?? m.href)} aria-current={m.current ? "true" : undefined} class={m.current ? "font-semibold text-card" : link}>
                {m.name} ({m.currency})
              </a>
            ))}
            {shop.locales.length > 1 && <span aria-hidden="true" class="text-white/30">|</span>}
            {shop.locales.length > 1 &&
              shop.locales.map((l) => (
                <a
                  href={l.locale === shop.locale ? undefined : (same(`${l.locale}-${country}`) ?? l.href)}
                  hreflang={l.locale}
                  lang={l.locale}
                  aria-current={l.locale === shop.locale ? "true" : undefined}
                  class={l.locale === shop.locale ? "font-semibold text-card" : link}
                >
                  {languageName(l.locale)}
                </a>
              ))}
          </nav>
        )
      }
    </div>
    <p class="container-shop border-t border-white/10 py-5 text-center text-xs text-panel-foreground/80">{t("footer.rights", { year: new Date().getFullYear(), shop: shop.name })}</p>
  </div>
</footer>
