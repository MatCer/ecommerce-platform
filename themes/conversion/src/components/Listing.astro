---
import type { ListingPage, ShopModel } from "@platform/storefront-sdk/types";
import FacetForm from "../islands/FacetForm";
import { i18n } from "../lib/i18n";
import Breadcrumbs from "./Breadcrumbs.astro";
import Facets from "./Facets.astro";
import Icon from "./Icon.astro";
import ProductGrid from "./ProductGrid.astro";

/**
 * A category page or search results: filter sidebar (a sheet on phones), title and description,
 * count + sort, grid, progress + pagination, empty state. The whole layout is one plain GET
 * form (progressive enhancement, spec §9.1), so the sort select and the facets submit together.
 */
interface Props {
  page: ListingPage;
  shop: ShopModel;
  /** The form action (the listing's own path, locale prefix included). */
  action: string;
}
const { page, shop, action } = Astro.props;
const { t, tn } = i18n(shop);
const { pagination: pg } = page;
const selected = page.facets.flatMap((f) =>
  f.values.filter((v) => v.selected).map((v) => ({ ...v, facet: f.label })),
);
const clearHref = page.category
  ? (page.breadcrumbs.at(-1)?.href ?? action)
  : `${action}?${new URLSearchParams({ q: page.query ?? "" })}`;
// Products seen so far (pages before this one are full).
const shown = pg.page >= pg.pages ? page.total : pg.page * page.products.length;
const hasFacets = page.facets.length > 0;
---

<div class="container-shop pb-16">
  <Breadcrumbs items={page.breadcrumbs} label={t("nav.breadcrumbs")} />
  <form id="facets" method="get" action={action} class="group/facets grid gap-6 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-8 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
    {page.query && <input type="hidden" name="q" value={page.query} />}
    <aside class="grid content-start gap-4">
      {
        page.subcategories.length > 0 && (
          <nav aria-label={t("nav.categories")} class="md:rounded-lg md:bg-muted md:p-5">
            <h2 class="mb-2 hidden text-base font-bold md:block">{t("nav.categories")}</h2>
            <ul class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:thin] md:grid md:gap-0 md:overflow-visible md:pb-0">
              {page.subcategories.map((c) => (
                <li class="shrink-0">
                  <a href={c.href} class="chip font-semibold md:min-h-11 md:justify-start md:border-0 md:bg-transparent md:px-0 md:font-medium md:hover:underline">{c.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {hasFacets && <Facets page={page} shop={shop} selected={selected.length} clearHref={clearHref} />}
    </aside>

    <div class="min-w-0">
      <header class="mb-5">
        <div class="flex flex-wrap items-baseline gap-x-3">
          <h1 class="text-3xl md:text-[2.5rem]">{page.title}</h1>
          <p class="text-[15px] text-muted-foreground">{tn("listing.count", page.total)}</p>
        </div>
        {
          page.category?.description_html && (
            // description_html is sanitized by the platform (contract: the only unescaped HTML).
            <div class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground md:text-base" set:html={page.category.description_html} />
          )
        }
      </header>
      {/* Nothing to sort or filter in an unfiltered empty result: straight to the way out. */}
      {
        (page.total > 0 || selected.length > 0) && (
          <div class="mb-4 flex flex-wrap items-center gap-3 border-y border-border py-3">
            {
              hasFacets && (
                <button type="button" popovertarget="filter-sheet" class="btn btn-secondary md:hidden">
                  <Icon name="sliders" />
                  {t("listing.filters")}
                  {selected.length > 0 && <span class="grid h-5 min-w-5 place-items-center rounded-full bg-foreground px-1.5 text-xs text-card">{selected.length}</span>}
                </button>
              )
            }
            <div class="ml-auto flex items-center gap-2 text-[15px]">
              <label for="sort" class="text-muted-foreground">{t("listing.sort")}</label>
              <select id="sort" name="sort" class="h-11 rounded-full border border-input bg-card pr-9 pl-4 font-semibold">
                {page.sort.map((s) => <option value={s.value} selected={s.selected}>{s.label}</option>)}
              </select>
              {/* Without JS sort needs a submit; with JS it submits on change (no button, no layout shift). */}
              <noscript><button type="submit" class="btn btn-secondary">{t("listing.apply")}</button></noscript>
            </div>
          </div>
        )
      }
      {
        selected.length > 0 && (
          <div class="mb-6 flex flex-wrap items-center gap-2">
            <h2 class="sr-only">{t("listing.active_filters")}</h2>
            <ul class="contents">
              {selected.map((v) => (
                <li>
                  <a href={v.href} class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-foreground pr-3 pl-4 text-sm font-medium text-card hover:bg-panel-raised">
                    <span class="sr-only">{t("listing.remove_filter", { label: `${v.facet} ${v.label}` })}</span>
                    <span aria-hidden="true">{v.facet}: {v.label}</span>
                    <Icon name="close" class="size-3.5" />
                  </a>
                </li>
              ))}
            </ul>
            <a href={clearHref} class="ml-1 inline-flex min-h-11 items-center text-sm font-semibold underline underline-offset-4">{t("listing.clear")}</a>
          </div>
        )
      }
      {
        page.products.length === 0 ? (
          <div class="mx-auto my-8 grid max-w-xl justify-items-center gap-3 rounded-xl bg-muted px-6 py-12 text-center">
            <Icon name="search" class="size-8 text-subtle" />
            <p class="text-lg font-semibold">{t(page.query !== undefined && page.query !== null ? "search.no_results" : "listing.empty")}</p>
            {page.query !== undefined && page.query !== null && <p class="text-muted-foreground">{t("search.hint")}</p>}
            <ul class="mt-2 flex flex-wrap justify-center gap-2">
              {shop.menus.main.map((m) => <li><a href={m.href} class="chip font-semibold">{m.label}</a></li>)}
            </ul>
          </div>
        ) : (
          <ProductGrid products={page.products} shop={shop} lcp listing label={t("search.products")} />
        )
      }
      {
        pg.pages > 1 && (
          <nav aria-label={t("listing.pagination")} class="mx-auto mt-12 grid max-w-sm justify-items-center gap-5">
            <div class="grid w-full max-w-64 gap-2 text-center text-sm text-muted-foreground">
              <p>{t("listing.progress", { shown, total: page.total })}</p>
              <progress max={page.total} value={shown} aria-hidden="true" class="h-1.5 w-full appearance-none overflow-hidden rounded-full bg-border [&::-moz-progress-bar]:bg-identity [&::-webkit-progress-bar]:bg-border [&::-webkit-progress-value]:bg-identity" />
            </div>
            <div class="flex w-full items-center justify-center gap-3">
              {pg.prev ? (
                <a rel="prev" href={pg.prev} class="btn btn-secondary">
                  <Icon name="chevronLeft" class="size-4" />
                  {t("listing.prev")}
                </a>
              ) : null}
              {pg.next ? (
                <a rel="next" href={pg.next} class="btn btn-primary h-14 flex-1 text-base">
                  {t("listing.next")}
                  <Icon name="chevronRight" class="size-4" />
                </a>
              ) : null}
            </div>
            <p class="text-xs text-muted-foreground">{t("listing.page", { page: pg.page, pages: pg.pages })}</p>
          </nav>
        )
      }
    </div>
  </form>
  {/* client:load, not idle: until it runs, Escape / outside click cannot close an open filter
      section, and changes would not submit. */}
  <FacetForm client:load form="facets" />
</div>
