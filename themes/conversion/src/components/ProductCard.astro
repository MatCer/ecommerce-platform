---
import { imageAttrs } from "@platform/storefront-sdk/format";
import type { ProductCard, ShopModel } from "@platform/storefront-sdk/types";
import { i18n, productHref } from "../lib/i18n";
import { CARD_SIZES, capped, cardImage } from "../lib/images";
import StockLine from "./StockLine.astro";

/**
 * The one card stanza every grid repeats: photo (−N % / new badges) → price row (sale price +
 * struck reference) and the visible 30-day lowest price (both shown first, the name is first in
 * the DOM) → name → brand → unit price → stock with colour swatches. The whole card is the link.
 * On pointer devices the second photo appears on hover/focus, and only devices with hover
 * download it (`<source media>`, a data: placeholder otherwise). On phones a card with several
 * photos swipes through up to five (scroll-snap rail, dots driven by CSS scroll timelines, no
 * JS); the rail sits above the name link's overlay so touch swipes reach it.
 */
interface Props {
  product: ProductCard;
  shop: ShopModel;
  /** Above-the-fold cards load eagerly; only the LCP card gets fetchpriority=high. */
  eager?: boolean;
  priority?: boolean;
  /** The slot's `sizes` when the card is not in a standard grid (lib/images.ts). */
  sizes?: string;
  /** Rendered wider than a grid card (home spotlight): keep the 960/1280 w candidates. */
  wide?: boolean;
  /** Phone photo rail; off inside a horizontal rail, where a swipe must move the rail. */
  swipe?: boolean;
}
const {
  product: p,
  shop,
  eager = false,
  priority = false,
  sizes = CARD_SIZES,
  wide = false,
  swipe = true,
} = Astro.props;
const { t } = i18n(shop);
const href = productHref(shop, p.slug);
const [main, hover] = p.images.map((i) => (wide ? capped(i, 1280) : cardImage(i)));
// Attributes are merged here: Astro renders a spread and a repeated attribute both, and HTML
// keeps the first.
const mainAttrs = main && imageAttrs(main, { sizes, priority, width: 360 });
const img = mainAttrs && { ...mainAttrs, loading: eager ? ("eager" as const) : mainAttrs.loading };
const slides = (swipe && p.images.length > 1 ? p.images.slice(0, 5) : []).map((s, i) =>
  i === 0 && img
    ? img
    : { ...imageAttrs(wide ? capped(s, 1280) : capped(s, 640), { sizes, width: 360 }), alt: "" },
);
const BLANK = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==";
// A18: a reduction (badge, strikethrough, %) only with the page model's reference price.
const reduced = p.reference_price && p.discount_percent ? p.discount_percent : null;
---

<article class="group relative flex w-full flex-col">
  <div class="card-photos relative aspect-[4/5] overflow-hidden rounded-lg bg-muted">
    {
      slides.length > 0 && (
        <div class="card-rail relative z-[1] focus-visible:-outline-offset-2 md:hidden" tabindex="0" role="group" aria-label={t("product.photos_of", { name: p.name })}>
          {slides.map((attrs) => (
            <a href={href} tabindex="-1" aria-hidden="true" class="block size-full">
              <img {...attrs} class="size-full object-cover" />
            </a>
          ))}
        </div>
      )
    }
    <div class:list={["size-full", slides.length > 0 && "hidden md:block"]}>
      {img && <img {...img} class="size-full object-cover" />}
      {
        hover && (
          <picture class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-focus-within:opacity-100 group-hover:opacity-100">
            <source media="(hover: hover) and (pointer: fine)" type="image/avif" srcset={hover.srcset} sizes={sizes} />
            <img src={BLANK} alt="" width={360} height={Math.round((hover.height / hover.width) * 360)} loading="lazy" decoding="async" fetchpriority="low" class="size-full object-cover" />
          </picture>
        )
      }
    </div>
    {
      slides.length > 0 && (
        <ol class="card-dots pointer-events-none absolute inset-x-0 bottom-2.5 z-[2] flex justify-center gap-1.5 md:hidden" aria-hidden="true">
          {slides.map(() => (
            <li />
          ))}
        </ol>
      )
    }
    {
      (reduced || p.badges.includes("new")) && (
        <ul class:list={["absolute top-3 left-3 flex items-center gap-1.5", slides.length > 0 && "pointer-events-none z-[2]"]}>
          {reduced && <li class="rounded-full bg-sale px-2.5 py-1 text-[0.8125rem] font-bold text-card"><span aria-hidden="true">−{reduced} %</span><span class="sr-only">{t("price.discount", { percent: reduced })}</span></li>}
          {p.badges.includes("new") && <li class="rounded-full bg-card px-2.5 py-1 text-[0.8125rem] font-bold text-foreground">{t("badge.new")}</li>}
        </ul>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 pt-3">
    <h3 class="text-[0.9375rem] leading-snug font-medium text-pretty md:text-base">
      <a href={href} class="outline-none after:absolute after:inset-0 after:rounded-lg focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-identity">{p.name}</a>
    </h3>
    <p class="order-first flex flex-wrap items-baseline gap-x-2">
      {reduced && <span class="sr-only">{t("price.current")}:</span>}
      <span class:list={["price text-[1.0625rem] md:text-lg", reduced && "text-sale"]}>{p.price_varies ? t("product.price_from", { price: p.price.formatted }) : p.price.formatted}</span>
      {reduced && p.reference_price && <s class="price text-sm font-medium text-subtle"><span class="sr-only">{t("price.original")}: </span>{p.reference_price.formatted}</s>}
    </p>
    {reduced && p.reference_price && <p class="order-first text-[0.8125rem] leading-snug text-muted-foreground">{t("price.lowest_30_days_short", { price: p.reference_price.formatted })}</p>}
    {p.brand && <p class="text-[0.8125rem] text-muted-foreground">{p.brand}</p>}
    {p.unit_price && <p class="text-[0.8125rem] text-muted-foreground">{t("price.unit", { price: p.unit_price.price.formatted, unit: p.unit_price.unit })}</p>}
    <div class="mt-1 flex items-center justify-between gap-2">
      <StockLine state={p.stock} label={t(`product.${p.stock}`)} />
      {
        p.swatches.length > 0 && (
          <p class="flex items-center">
            <span class="sr-only">{t("product.colors", { names: p.swatches.map((s) => s.name).join(", ") })}</span>
            <span class="flex items-center gap-1.5" aria-hidden="true">
              {p.swatches.slice(0, 4).map((s) => (
                <svg class="size-4 rounded-full border border-black/10 ring-1 ring-white" viewBox="0 0 16 16">
                  <circle cx="8" cy="8" r="8" fill={s.color} />
                </svg>
              ))}
              {p.swatches.length > 4 && <span class="text-[0.8125rem] text-muted-foreground">+{p.swatches.length - 4}</span>}
            </span>
          </p>
        )
      }
    </div>
  </div>
</article>
