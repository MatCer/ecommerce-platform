---
import Icon from "./Icon.astro";

/**
 * Home section heading: left-aligned h2, optional subtitle under it, optional inline
 * "view all" link on the right baseline.
 */
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  /** "View all" target and its label (both or neither). */
  link?: { href: string; label: string };
}
const { id, title, subtitle, link } = Astro.props;
---

<div class="mb-5 flex items-end justify-between gap-4 md:mb-7">
  <div>
    <h2 id={id} class="text-2xl md:text-[2rem]">{title}</h2>
    {subtitle && <p class="mt-1 text-[0.9375rem] text-muted-foreground">{subtitle}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="inline-flex min-h-11 shrink-0 items-center gap-1.5 text-[0.9375rem] font-semibold underline-offset-4 hover:underline">
        {link.label}
        <Icon name="arrowRight" class="size-4" />
      </a>
    )
  }
</div>
