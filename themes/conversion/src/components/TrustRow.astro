---
import type { DeliveryEstimate, ShopModel } from "@platform/storefront-sdk/types";
import { i18n } from "../lib/i18n";
import Icon from "./Icon.astro";

/**
 * Delivery, returns and payment facts inside the PDP buy panel (family rule: trust sits in the
 * buy decision's field of view, not in small print). A product's delivery estimate replaces the
 * shop's generic delivery promise.
 */
interface Props {
  shop: ShopModel;
  delivery?: DeliveryEstimate | null;
}
const { shop, delivery } = Astro.props;
const { t } = i18n(shop);
const day = (d: string) =>
  new Date(`${d}T12:00:00Z`).toLocaleDateString(shop.locale, {
    weekday: "short",
    day: "numeric",
    month: "numeric",
    timeZone: "UTC",
  });
const threshold = shop.free_shipping_threshold;
const rows = [
  {
    icon: "truck",
    // The product's dates (else the shop's promise) lead; the free-delivery threshold follows.
    lead: delivery
      ? t("product.delivery", { from: day(delivery.from), to: day(delivery.to) })
      : shop.trust.delivery,
    text: threshold ? t("trust.free_shipping_from", { amount: threshold.formatted }) : null,
  },
  { icon: "returns", lead: null, text: shop.trust.returns },
  // Only the methods checkout offers; no row when none is set up yet.
  ...(shop.trust.payments.length > 0
    ? [{ icon: "card", lead: null, text: shop.trust.payments.join(" · ") } as const]
    : []),
] as const;
---

<ul class="grid gap-2 text-[15px]">
  {rows.map((r) => (
    <li class="flex items-start gap-3">
      <Icon name={r.icon} class="mt-0.5 size-5 shrink-0 text-identity-ink" />
      <span>{r.lead && <strong class="font-semibold">{r.lead}</strong>}{r.lead && r.text && " · "}{r.text}</span>
    </li>
  ))}
</ul>
