---
import type { ShopModel } from "@platform/storefront-sdk/types";
import { i18n } from "../lib/i18n";
import Icon from "./Icon.astro";

/**
 * The shop's real promises in one slim grey line, under the header and again above the footer:
 * free delivery threshold (else the delivery promise), returns, payment methods. Phones show the
 * first one only (tablets the first two). Nothing here is invented: every fact comes from the shop model.
 */
interface Props {
  shop: ShopModel;
  /** Which edge borders the page content: under the header "bottom", above the footer "top". */
  edge?: "top" | "bottom";
}
const { shop, edge = "bottom" } = Astro.props;
const { t } = i18n(shop);
const facts: { icon: "truck" | "returns" | "card"; text: string }[] = [
  {
    icon: "truck",
    text: shop.free_shipping_threshold
      ? t("trust.free_shipping_from", { amount: shop.free_shipping_threshold.formatted })
      : shop.trust.delivery,
  },
  { icon: "returns", text: shop.trust.returns },
  ...(shop.trust.payments.length > 0
    ? [{ icon: "card" as const, text: shop.trust.payments.join(" · ") }]
    : []),
];
---

<div class:list={["border-border bg-muted text-foreground", edge === "top" ? "border-t" : "border-b"]}>
  <ul class="container-shop flex min-h-9 items-center justify-center gap-8 py-1.5 text-[0.8125rem] font-medium md:justify-between">
    {
      facts.map((f, i) => (
        <li class:list={["items-center gap-2", i === 0 ? "flex" : i === 1 ? "hidden md:flex" : "hidden lg:flex"]}>
          <Icon name={f.icon} class="size-[1.125rem] shrink-0 text-identity-ink" />
          {f.text}
        </li>
      ))
    }
  </ul>
</div>
