---
import Base from "../layouts/Base.astro";
import { i18n } from "../lib/i18n";
import { storefront } from "../lib/storefront";

const shop = await storefront(Astro.request).shop();
const { t, href } = i18n(shop);
Astro.response.status = 404;
---

<Base shop={shop} template="404" seo={{ title: `${t("notfound.title")} | ${shop.name}`, description: "", canonical: Astro.url.href, alternates: [], json_ld: [], robots: "noindex" }}>
  <div class="container-shop grid max-w-2xl justify-items-start gap-4 py-16 md:py-24">
    <p class="eyebrow text-identity-ink">404</p>
    <h1 class="text-4xl font-bold md:text-5xl">{t("notfound.title")}</h1>
    <p class="text-lg text-muted-foreground">{t("notfound.text")}</p>
    <form action={href("/search")} method="get" role="search" class="flex w-full max-w-md gap-2">
      <label for="nf-q" class="sr-only">{t("search.label")}</label>
      <input id="nf-q" name="q" type="search" placeholder={t("search.placeholder")} class="h-11 min-w-0 flex-1 rounded-md border border-border bg-card px-4" />
      <button type="submit" class="btn btn-primary">{t("search.label")}</button>
    </form>
    <ul class="flex flex-wrap gap-2">
      {shop.menus.main.map((m) => <li><a href={m.href} class="chip font-semibold">{m.label}</a></li>)}
    </ul>
    <a href={href("/")} class="font-semibold text-identity-ink underline underline-offset-4">{t("notfound.back")}</a>
  </div>
</Base>
