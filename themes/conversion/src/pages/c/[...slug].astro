---
import Listing from "../../components/Listing.astro";
import Base from "../../layouts/Base.astro";
import { LISTING_SIZES, cardImage } from "../../lib/images";
import { listingQuery, storefront } from "../../lib/storefront";

const sf = storefront(Astro.request);
const [shop, page] = await Promise.all([
  sf.shop(),
  sf.category(Astro.params.slug ?? "", listingQuery(Astro.url)),
]);
if (!page) return Astro.rewrite("/404");
const first = page.products[0]?.images[0] && cardImage(page.products[0].images[0]);
---

<Base shop={shop} seo={page.seo} template="category" lcp={first && { image: first, sizes: LISTING_SIZES }}>
  <Listing page={page} shop={shop} action={`${shop.base_path}${Astro.url.pathname}`} />
</Base>
