---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import ProductDetails from "../../components/ProductDetails.astro";
import RecommendationSlot from "../../components/RecommendationSlot.astro";
import Reviews from "../../components/Reviews.astro";
import Stars from "../../components/Stars.astro";
import TrustRow from "../../components/TrustRow.astro";
import WatchForm from "../../components/WatchForm.astro";
import BuyBox from "../../islands/BuyBox";
import Gallery from "../../islands/Gallery";
import RecentlyViewed from "../../islands/RecentlyViewed";
import Base from "../../layouts/Base.astro";
import { i18n } from "../../lib/i18n";
import { GALLERY_SIZES } from "../../lib/images";
import { storefront } from "../../lib/storefront";

const sf = storefront(Astro.request);
const pagePromise = sf.product(Astro.params.slug ?? "");
// Recommendations are below the fold. Start their optional request as soon as the product
// arrives, while the independent shop request may still be running.
const recommendedPromise = pagePromise.then((result) =>
  result
    ? sf.recommendations(`product:${result.product.id}`, { limit: 4 }).catch(() => null)
    : null,
);
const [shop, page, recommended] = await Promise.all([sf.shop(), pagePromise, recommendedPromise]);
if (!page) return Astro.rewrite("/404");
const { product: p } = page;
const { t, tn, pick } = i18n(shop);
const rating = page.reviews.summary;
const recommendedTitle =
  recommended?.title ??
  t(
    recommended?.strategy === "bought_together" ? "product.bought_together" : "product.recommended",
  );
const firstImage = p.images[0];
const BUY_KEYS = [
  "price.current",
  "price.original",
  "price.discount",
  "price.lowest_30_days",
  "price.unit",
  "product.vat_included",
  "product.unavailable",
  "product.combination_unavailable",
  "product.sku",
  "product.in_stock",
  "product.low_stock",
  "product.backorder",
  "product.out_of_stock",
  "cart.add",
  "cart.adding",
  "cart.added",
  "cart.add_failed",
];
---

<Base shop={shop} seo={page.seo} template="product" productId={p.id} bottomBar lcp={firstImage && { image: firstImage, sizes: GALLERY_SIZES }}>
  <div class="container-shop pb-16">
    <Breadcrumbs items={page.breadcrumbs} label={t("nav.breadcrumbs")} />
    <div class="grid gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-10 lg:gap-14">
      <Gallery client:idle images={p.images} labels={pick(["product.gallery", "product.image", "product.prev_image", "product.next_image"])} />
      <!-- Not sticky while the watch form is open: the column would outgrow the viewport. -->
      <div class="flex flex-col gap-4 md:sticky md:top-24 md:self-start md:has-[#watch[open]]:static">
        <div>
          {p.brand && <p class="mb-2 text-sm font-semibold text-muted-foreground">{p.brand}</p>}
          <h1 class="text-3xl md:text-[2.5rem]">{p.name}</h1>
          {
            rating && (
              <a href="#reviews" class="mt-3 inline-flex min-h-6 items-center gap-2 text-[15px] underline-offset-4 hover:underline">
                <Stars rating={rating.average} label={t("reviews.average", { average: rating.average.toLocaleString(shop.locale) })} />
                <span class="font-semibold" aria-hidden="true">{rating.average.toLocaleString(shop.locale, { maximumFractionDigits: 1 })}</span>
                <span class="text-muted-foreground">· {tn("reviews.count", rating.count)}</span>
              </a>
            )
          }
          {p.short_description && <p class="mt-3 text-[17px] text-pretty text-muted-foreground">{p.short_description}</p>}
        </div>
        <!-- Buy panel: delivery, returns and payments stay next to the button (SHOP-84). -->
        <div class="grid gap-4 rounded-xl bg-muted p-5 md:p-6">
          <BuyBox client:idle options={p.options} variants={p.variants} labels={pick(BUY_KEYS)} selected={Astro.url.searchParams.get("variant")} />
          <TrustRow shop={shop} delivery={page.delivery_estimate} />
        </div>
        <WatchForm shop={shop} product={p} selected={Astro.url.searchParams.get("variant")} />
        <p class="flex items-center gap-4 rounded-xl bg-guarantee-wash px-5 py-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-card text-identity-ink"><Icon name="shield" class="size-6" /></span>
          <span class="font-semibold">{shop.trust.returns}</span>
        </p>
      </div>
    </div>

    <!-- Sticky on phones right under the header (56px bar + 44px category row + 2 hairlines,
         sharing its bottom one), so nothing in it is ever covered. -->
    <nav aria-label={t("product.sections")} class="sticky top-[101px] z-20 -mx-4 mt-12 border-y border-border bg-card/95 px-4 backdrop-blur-sm md:static md:mx-0 md:mt-16 md:px-0">
      <ul class="flex gap-7 overflow-x-auto text-[15px] font-semibold [scrollbar-width:none]">
        <li><a href="#pd-description" class="flex min-h-12 items-center border-b-2 border-transparent hover:border-foreground">{t("product.description")}</a></li>
        {p.parameters.length > 0 && <li><a href="#pd-parameters" class="flex min-h-12 items-center border-b-2 border-transparent hover:border-foreground">{t("product.parameters")}</a></li>}
        {rating && <li><a href="#reviews" class="flex min-h-12 items-center border-b-2 border-transparent hover:border-foreground">{t("reviews.title")} <span class="ml-1 text-muted-foreground">{rating.count}</span></a></li>}
      </ul>
    </nav>

    <ProductDetails product={p} shop={shop} />
    <Reviews reviews={page.reviews} shop={shop} />
    <RecommendationSlot products={recommended?.products ?? []} shop={shop} title={recommendedTitle} id="recommended" />
    <RecentlyViewed client:idle title={t("product.recently_viewed")} base={shop.base_path} current={p.id} labels={pick(["product.price_from"])} />
  </div>
</Base>
