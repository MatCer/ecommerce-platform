---
import Listing from "../components/Listing.astro";
import Base from "../layouts/Base.astro";
import { i18n } from "../lib/i18n";
import { LISTING_SIZES, cardImage } from "../lib/images";
import { listingQuery, storefront } from "../lib/storefront";

const sf = storefront(Astro.request);
const [shop, page] = await Promise.all([sf.shop(), sf.search(listingQuery(Astro.url))]);
const first = page.products[0]?.images[0] && cardImage(page.products[0].images[0]);
// An empty query still lists the catalog; its heading must not read "Results for “”".
const title = page.query?.trim() ? page.title : i18n(shop).t("search.title");
---

<Base shop={shop} seo={page.seo} template="search" q={page.query ?? ""} lcp={first && { image: first, sizes: LISTING_SIZES }}>
  <Listing page={{ ...page, title }} shop={shop} action={`${shop.base_path}/search`} />
</Base>
