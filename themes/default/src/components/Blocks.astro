---
import { imageAttrs } from "@platform/storefront-sdk/format";
import type { ContentBlock, ShopModel } from "@platform/storefront-sdk/types";
import Icon from "./Icon.astro";
import ProductGrid from "./ProductGrid.astro";
import Prose from "./Prose.astro";

/**
 * Content blocks of CMS pages and blog posts (WP13). Only `rich_text.html` and FAQ answers are
 * rendered unescaped: the platform sanitizes them on write. FAQ items use native
 * <details>/<summary> (keyboard and screen-reader support without JS).
 */
interface Props {
  blocks: ContentBlock[];
  shop: ShopModel;
}
const { blocks, shop } = Astro.props;
const IMAGE_SIZES = "(min-width: 48rem) 42rem, 100vw";
---

<div class="grid gap-6 [&>*:not(section)]:max-w-3xl">
  {
    blocks.map((b) => {
      switch (b.type) {
        case "heading":
          return b.level === 3 ? (
            <h3 class="mt-2 text-xl font-bold">{b.text}</h3>
          ) : (
            <h2 class="mt-4 text-2xl font-extrabold">{b.text}</h2>
          );
        case "rich_text":
          return <Prose content_html={b.html} />;
        case "image":
          return (
            <figure class="grid gap-2">
              <img {...imageAttrs(b.image, { sizes: IMAGE_SIZES, width: 720 })} class="w-full rounded-xl" />
              {b.caption && <figcaption class="text-sm text-muted-foreground">{b.caption}</figcaption>}
            </figure>
          );
        case "button":
          return (
            <p>
              <a href={b.href} class="btn btn-primary px-6">
                {b.label}
                <Icon name="chevronRight" class="size-4" />
              </a>
            </p>
          );
        case "product_grid":
          return b.products.length === 0 ? null : (
            <section class="grid gap-4">
              {b.title ? <h2 class="text-2xl font-extrabold">{b.title}</h2> : null}
              <ProductGrid products={b.products} shop={shop} label={b.title ? undefined : shop.name} />
            </section>
          );
        case "faq":
          return (
            <div class="grid gap-2">
              {b.items.map((item) => (
                <details class="surface group px-4 py-3">
                  <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                    {item.question}
                    <Icon name="chevronRight" class="size-4 shrink-0 transition-transform group-open:rotate-90" />
                  </summary>
                  <div class="pt-2">
                    <Prose content_html={item.answer_html} />
                  </div>
                </details>
              ))}
            </div>
          );
        default:
          return null;
      }
    })
  }
</div>
