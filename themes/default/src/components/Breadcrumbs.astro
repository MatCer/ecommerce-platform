---
import type { Link } from "@platform/storefront-sdk/types";

/** Breadcrumb trail; its BreadcrumbList JSON-LD comes with the page model's `seo.json_ld`. */
interface Props {
  items: Link[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="mb-4 text-sm text-muted-foreground">
  <ol class="flex flex-wrap gap-1">
    {
      items.map((b, i) => (
        <li class="flex gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? <span aria-current="page">{b.label}</span> : <a href={b.href} class="hover:underline">{b.label}</a>}
        </li>
      ))
    }
  </ol>
</nav>
