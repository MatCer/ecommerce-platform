---
import type { ProductCard as Card, ShopModel } from "@platform/storefront-sdk/types";
import ProductCard from "./ProductCard.astro";

/**
 * Product grid: 2 columns, 3 from 48rem, 4 from 64rem (CARD_SIZES in lib/images.ts describes
 * exactly this). `lcp` marks the first card as the page's LCP image.
 */
interface Props {
  products: Card[];
  shop: ShopModel;
  lcp?: boolean;
  /** Visually hidden heading when the grid has no visible one (keeps heading order). */
  label?: string;
}
const { products, shop, lcp = false, label } = Astro.props;
---

{label && <h2 class="sr-only">{label}</h2>}
<ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4">
  {
    products.map((p, i) => (
      <li class="flex">
        <ProductCard product={p} shop={shop} eager={lcp && i < 2} priority={lcp && i === 0} />
      </li>
    ))
  }
</ul>
