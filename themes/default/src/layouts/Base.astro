---
import ConsentBanner from "@platform/storefront-sdk/consent-banner";
import { lcpImage } from "@platform/storefront-sdk/format";
import type { Image, Seo, ShopModel } from "@platform/storefront-sdk/types";
import "virtual:theme-tokens.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import archivo from "../fonts/archivo-latin-ext.woff2?url";
import Rum from "../islands/Rum";
import { i18n } from "../lib/i18n";
import { jsonLd } from "../lib/storefront";

/**
 * Page shell: SEO head from the page model, header, main landmark, footer, consent, RUM.
 * Every page renders inside it.
 */
interface Props {
  shop: ShopModel;
  seo: Seo;
  /** Page template for RUM grouping (`home`, `category`, `product`, `search`, `page`). */
  template: string;
  /** Product pages: the product id for the `view_item` analytics event. */
  productId?: string;
  /** The LCP image: preloaded AVIF with fetchpriority=high, same `sizes` as its <img> (§9.6). */
  lcp?: { image: Image; sizes: string };
  /** The page shows a fixed bottom bar on phones (product buy bar): keep the footer clear. */
  bottomBar?: boolean;
  /** Current search query, echoed in the header search box. */
  q?: string;
}
const { shop, seo, template, productId, lcp, q, bottomBar = false } = Astro.props;
const { t, pick } = i18n(shop);
const preload = lcp && lcpImage(lcp.image, lcp.sizes).preload;
const ogImage = lcp && new URL(lcp.image.src, seo.canonical).href;
const CONSENT_KEYS = [
  "legal.cookies",
  "consent.title",
  "consent.text",
  "consent.accept",
  "consent.reject",
  "consent.settings",
  "consent.save",
  "consent.necessary",
  ...shop.consent.purposes.map((p) => `consent.${p}`),
];
---

<!doctype html>
<html lang={shop.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    <link rel="canonical" href={seo.canonical} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    {seo.alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <meta property="og:type" content={template === "product" ? "product" : "website"} />
    <meta property="og:site_name" content={shop.name} />
    <meta property="og:title" content={seo.title} />
    {seo.description && <meta property="og:description" content={seo.description} />}
    <meta property="og:url" content={seo.canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {preload && <link {...preload} />}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {seo.json_ld.map((d) => <script type="application/ld+json" set:html={jsonLd(d)} />)}
  </head>
  <body class:list={["flex min-h-dvh flex-col antialiased", bottomBar && "pb-20 md:pb-0"]}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-card focus:px-4 focus:py-3 focus:font-semibold focus:shadow-lg">
      {t("nav.skip")}
    </a>
    <Header shop={shop} q={q} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer shop={shop} alternates={seo.alternates} />
    <ConsentBanner client:idle purposes={shop.consent.purposes} policyUrl={shop.consent.policy_url} textVersion={shop.consent.text_version} labels={pick(CONSENT_KEYS)} />
    <Rum client:idle sampleRate={shop.tracking.rum_sample_rate} template={template} productId={productId} />
  </body>
</html>
