---
import { imageAttrs } from "@platform/storefront-sdk/format";
import Base from "../../layouts/Base.astro";
import { i18n } from "../../lib/i18n";
import { CARD_SIZES } from "../../lib/images";
import { storefront } from "../../lib/storefront";

// Blog index: published posts, newest first (WP13).
const sf = storefront(Astro.request);
const [shop, blog] = await Promise.all([sf.shop(), sf.blog()]);
if (!blog) return Astro.rewrite("/404");
const { t } = i18n(shop);
const date = (d: string) =>
  new Date(d).toLocaleDateString(shop.locale, { dateStyle: "long", timeZone: "UTC" });
---

<Base shop={shop} seo={blog.seo} template="blog">
  <div class="container-shop py-8">
    <h1 class="mb-8 text-4xl font-extrabold">{blog.title || t("blog.title")}</h1>
    {
      blog.posts.length === 0 ? (
        <p class="text-muted-foreground">{t("blog.empty")}</p>
      ) : (
        <ul class="grid gap-6 md:grid-cols-3">
          {blog.posts.map((post) => (
            <li>
              <article class="group relative surface overflow-hidden">
                {post.image && <img {...imageAttrs(post.image, { sizes: CARD_SIZES, width: 480 })} class="aspect-[4/3] w-full object-cover" />}
                <div class="grid gap-2 p-5">
                  <time datetime={post.published_at} class="text-xs text-muted-foreground">{date(post.published_at)}</time>
                  <h2 class="text-xl font-bold"><a href={post.href} class="after:absolute after:inset-0">{post.title}</a></h2>
                  <p class="text-muted-foreground">{post.excerpt}</p>
                  <span aria-hidden="true" class="text-sm font-semibold text-identity-ink">{t("blog.read_more")} →</span>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
