---
import Listing from "../../components/Listing.astro";
import Base from "../../layouts/Base.astro";
import { storefront } from "../../lib/storefront";

const sf = storefront(Astro.request);
const query = Object.fromEntries(
  [...new Set(Astro.url.searchParams.keys())].map((k) => [k, Astro.url.searchParams.getAll(k)]),
);
const [shop, page] = await Promise.all([sf.shop(), sf.category(Astro.params.slug ?? "", query)]);
if (!page) return Astro.rewrite("/404");
const first = page.products[0]?.images[0];
---

<Base shop={shop} seo={page.seo} lcp={first && { image: first, sizes: "(min-width: 64rem) 18rem, (min-width: 48rem) 30vw, calc(50vw - 1.5rem)" }}>
  <Listing page={page} action={Astro.url.pathname} messages={shop.messages} />
</Base>
