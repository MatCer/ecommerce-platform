---
import { imageAttrs, t } from "@platform/storefront-sdk/format";
import ProductCard from "../components/ProductCard.astro";
import Base from "../layouts/Base.astro";
import { storefront } from "../lib/storefront";

const sf = storefront(Astro.request);
const [shop, home] = await Promise.all([sf.shop(), sf.home()]);
const m = shop.messages;
// Category tiles come first and are the largest above-the-fold images: the first one is the LCP.
const CARD_SIZES = "(min-width: 64rem) 18rem, (min-width: 48rem) 30vw, calc(50vw - 1.5rem)";
const TILE_SIZES = "(min-width: 48rem) 25vw, calc(50vw - 1.5rem)";
const tile = home.categories[0]?.image;
const lcp = tile
  ? { image: tile, sizes: TILE_SIZES }
  : home.featured[0]?.images[0] && { image: home.featured[0].images[0], sizes: CARD_SIZES };
---

<Base shop={shop} seo={home.seo} lcp={lcp}>
  <h1 class="sr-only">{shop.name}</h1>
  <section aria-label={t(m, "home.categories")} class="mb-8 grid grid-cols-2 gap-3 md:grid-cols-4">
    {
      home.categories.map((c, i) => (
        <a href={c.href} class="group overflow-hidden rounded-lg border border-border bg-card">
          {c.image ? <img {...imageAttrs(c.image, { sizes: TILE_SIZES, width: 360, priority: i === 0 })} loading="eager" class="aspect-[4/5] w-full bg-muted object-cover" /> : <span class="block aspect-[4/5] w-full bg-muted" />}
          <span class="block p-2 text-center font-display font-bold">{c.label}</span>
        </a>
      ))
    }
  </section>
  <h2 class="mb-4 font-display text-xl font-bold">{t(m, "home.featured")}</h2>
  <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
    {home.featured.map((p, i) => <li class="flex"><ProductCard product={p} messages={m} eager={!tile && i < 2} priority={!tile && i === 0} /></li>)}
  </ul>
</Base>
