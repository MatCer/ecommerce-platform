---
import { imageUrl } from "@platform/storefront-sdk/format";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductDetails from "../../components/ProductDetails.astro";
import RecommendationSlot from "../../components/RecommendationSlot.astro";
import TrustRow from "../../components/TrustRow.astro";
import BuyBox from "../../islands/BuyBox";
import Gallery from "../../islands/Gallery";
import RecentlyViewed from "../../islands/RecentlyViewed";
import Base from "../../layouts/Base.astro";
import { i18n } from "../../lib/i18n";
import { GALLERY_SIZES } from "../../lib/images";
import { storefront } from "../../lib/storefront";

const sf = storefront(Astro.request);
const [shop, page] = await Promise.all([sf.shop(), sf.product(Astro.params.slug ?? "")]);
if (!page) return Astro.rewrite("/404");
const { product: p } = page;
const { t, pick } = i18n(shop);
// An optional slot must never take the page down with it.
const recommended = await sf
  .recommendations(`product:${p.id}`)
  .then((r) => r.products)
  .catch(() => []);
const firstImage = p.images[0];
const BUY_KEYS = [
  "price.current",
  "price.original",
  "price.discount",
  "price.lowest_30_days",
  "price.unit",
  "product.vat_included",
  "product.unavailable",
  "product.combination_unavailable",
  "product.sku",
  "product.in_stock",
  "product.low_stock",
  "product.backorder",
  "product.out_of_stock",
  "cart.add",
  "cart.adding",
  "cart.added",
  "cart.add_failed",
];
---

<Base shop={shop} seo={page.seo} template="product" bottomBar lcp={firstImage && { image: firstImage, sizes: GALLERY_SIZES }}>
  <div class="container-shop">
    <Breadcrumbs items={page.breadcrumbs} label={t("nav.breadcrumbs")} />
    <div class="grid gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-10 lg:gap-14">
      <Gallery client:idle images={p.images} labels={pick(["product.gallery", "product.image", "product.prev_image", "product.next_image"])} />
      <div class="flex flex-col gap-6 md:sticky md:top-36 md:self-start">
        <div>
          {p.brand && <p class="eyebrow mb-2 text-identity-ink">{p.brand}</p>}
          <h1 class="text-3xl leading-tight font-extrabold md:text-4xl">{p.name}</h1>
          {p.short_description && <p class="mt-2 text-muted-foreground">{p.short_description}</p>}
        </div>
        <BuyBox client:idle options={p.options} variants={p.variants} labels={pick(BUY_KEYS)} selected={Astro.url.searchParams.get("variant")} />
        <div class="border-t border-border pt-5">
          <TrustRow shop={shop} layout="list" delivery={page.delivery_estimate} />
        </div>
      </div>
    </div>

    <ProductDetails product={p} shop={shop} />
    <RecommendationSlot products={recommended} shop={shop} title={t("product.recommended")} id="recommended" />
    <RecentlyViewed
      client:idle
      title={t("product.recently_viewed")}
      base={shop.base_path}
      current={{ slug: p.slug, name: p.name, image: firstImage && imageUrl(firstImage, 360) }}
    />
  </div>
</Base>
