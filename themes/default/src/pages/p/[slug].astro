---
import { pick, t } from "@platform/storefront-sdk/format";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BuyBox from "../../islands/BuyBox";
import Gallery from "../../islands/Gallery";
import Base from "../../layouts/Base.astro";
import { storefront } from "../../lib/storefront";

const sf = storefront(Astro.request);
const [shop, page] = await Promise.all([sf.shop(), sf.product(Astro.params.slug ?? "")]);
if (!page) return Astro.rewrite("/404");
const { product: p } = page;
const m = shop.messages;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString(shop.locale, {
    weekday: "short",
    day: "numeric",
    month: "numeric",
  });
const firstImage = p.images[0];
const BUY_KEYS = [
  "price.original",
  "price.lowest_30_days",
  "price.unit",
  "product.vat_included",
  "product.unavailable",
  "product.in_stock",
  "product.low_stock",
  "product.backorder",
  "product.out_of_stock",
  "cart.add",
  "cart.adding",
  "cart.added",
  "cart.add_failed",
];
const g = p.gpsr;
---

<Base shop={shop} seo={page.seo} lcp={firstImage && { image: firstImage, sizes: "(min-width: 48rem) 50vw, calc(100vw - 2rem)" }}>
  <Breadcrumbs items={page.breadcrumbs} label={t(m, "nav.breadcrumbs")} />
  <div class="grid gap-6 md:grid-cols-2 md:gap-10">
    <Gallery client:visible images={p.images} label={t(m, "product.gallery")} />
    <div class="flex flex-col gap-5">
      <div>
        {p.brand && <p class="text-sm text-muted-foreground">{p.brand}</p>}
        <h1 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{p.name}</h1>
      </div>
      <BuyBox client:idle options={p.options} variants={p.variants} labels={pick(m, BUY_KEYS)} />
      <ul class="grid gap-2 border-y border-border py-4 text-sm text-muted-foreground">
        {page.delivery_estimate && <li>🚚 {t(m, "product.delivery", { from: fmt(page.delivery_estimate.from), to: fmt(page.delivery_estimate.to) })}</li>}
        <li>↩︎ {shop.trust.returns}</li>
        <li>💳 {shop.trust.payments.join(" · ")}</li>
      </ul>
    </div>
  </div>

  <section class="mt-10 grid gap-8 md:grid-cols-2" aria-label={t(m, "product.details")}>
    <div>
      <h2 class="mb-3 font-display text-xl font-bold">{t(m, "product.description")}</h2>
      <!-- description_html is sanitized by the platform (contract: the only unescaped HTML). -->
      <div class="grid gap-3 leading-relaxed [&_ul]:list-disc [&_ul]:pl-5" set:html={p.description_html} />
    </div>
    <div>
      <h2 class="mb-3 font-display text-xl font-bold">{t(m, "product.parameters")}</h2>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {
          p.parameters.map((x) => (
            <>
              <dt class="text-muted-foreground">{x.name}</dt>
              <dd>{x.value}</dd>
            </>
          ))
        }
      </dl>
      {
        g && (
          <details class="mt-6 text-sm">
            <summary class="cursor-pointer font-semibold">{t(m, "product.safety")}</summary>
            {g.manufacturer && (
              <p class="mt-2 text-muted-foreground">
                {t(m, "product.manufacturer")}: {g.manufacturer.name}, {g.manufacturer.address}
                {g.manufacturer.email && <>, {g.manufacturer.email}</>}
              </p>
            )}
            {g.eu_responsible_person && (
              <p class="text-muted-foreground">
                {t(m, "product.eu_responsible")}: {g.eu_responsible_person.name}, {g.eu_responsible_person.address}
              </p>
            )}
            {g.safety_info && <p class="mt-2 text-muted-foreground">{g.safety_info}</p>}
            {g.warnings && <p class="mt-2 text-muted-foreground">{t(m, "product.warnings")}: {g.warnings}</p>}
          </details>
        )
      }
    </div>
  </section>
</Base>
