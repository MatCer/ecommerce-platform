---
import Listing from "../components/Listing.astro";
import Base from "../layouts/Base.astro";
import { storefront } from "../lib/storefront";

const sf = storefront(Astro.request);
const query = Object.fromEntries(
  [...new Set(Astro.url.searchParams.keys())].map((k) => [k, Astro.url.searchParams.getAll(k)]),
);
const [shop, page] = await Promise.all([sf.shop(), sf.search(query)]);
---

<Base shop={shop} seo={page.seo} q={Astro.url.searchParams.get("q") ?? ""}>
  <Listing page={page} action="/search" messages={shop.messages} />
</Base>
